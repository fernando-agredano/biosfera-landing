---
export interface Props {
  title?: string;
}
const { title = 'BIOSFERA — Luz & Sonido' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preload" as="image" href="/logo.png" />

  <!-- Fonts — preconnect + preload para eliminar FOUT en primera carga -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=block" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=block" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=block" /></noscript>

</head>
<body>
  <!-- CDN libs ANTES del slot — garantiza que GSAP exista
       cuando el script inline de index.astro se ejecute -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- 3. Contenido de la página (componentes + script inline de main.js) -->
  <slot />
</body>
</html>

<style is:global>
  /* ─── RESET & TOKENS ─── */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --blue:   #00d4ff;
    --purple: #a855f7;
    --pink:   #ff2d78;
    --bg:     #07091e;
    --bg2:    #0b0d24;
    --bg3:    #10132c;
    --white:  #eeeef5;
    --muted:  #7a7a96;
    --subtle: #9898b4;
    --ff-display: 'Bebas Neue', sans-serif;
    --ff-mono:    'Space Mono', monospace;
    --ff-body:    'Inter', sans-serif;
  }

  html { scroll-behavior: auto; }

  body {
    font-family: var(--ff-body);
    background: var(--bg);
    color: var(--white);
    overflow-x: hidden;
  }

  /* Reset general — excluye logos con tamaño fijo */
  img:not(.nav-logo-img):not(.foot-logo-img):not(.hero-logo):not(.hero-dj-img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
  }
  .nav-logo-img, .foot-logo-img, .hero-logo, .hero-dj-img { display: block; }

  /* Logo en hero */
  .hero-logo {
    width: 140px; height: 140px; object-fit: contain;
    margin: 0 auto -0.4rem;
    filter: brightness(0) invert(1) drop-shadow(0 0 24px rgba(0,212,255,.75));
    animation: logoFloat 3s ease-in-out infinite;
  }
  @keyframes logoFloat {
    0%,100% { transform: translateY(0);    filter: brightness(0) invert(1) drop-shadow(0 0 24px rgba(0,212,255,.75)); }
    50%      { transform: translateY(-8px); filter: brightness(0) invert(1) drop-shadow(0 0 36px rgba(168,85,247,.9)); }
  }
  a   { text-decoration: none; color: inherit; }


  /* ─── NAV ─── */
  #mainNav {
    position: fixed; inset: 0 0 auto 0; z-index: 200;
    display: flex; justify-content: center; align-items: center;
    padding: 1.6rem 0;
    transition: background .35s ease, backdrop-filter .35s ease;
  }
  .nav-inner {
    width: min(1380px, 100%);
    margin: 0 auto;
    padding: 0 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  #mainNav::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(7,9,30,.92), transparent);
    pointer-events: none;
  }
  #mainNav.nav-scrolled {
    background: rgba(7, 9, 30, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  #mainNav.nav-scrolled::before { display: none; }

  .nav-logo {
    display: flex; align-items: center; gap: .7rem;
    font-family: var(--ff-display);
    font-size: 1.4rem; letter-spacing: .12em;
    position: relative; z-index: 1; line-height: 1;
  }
  .nav-logo-img {
    width: 52px; height: 52px; object-fit: contain; flex-shrink: 0;
    filter: brightness(0) invert(1) drop-shadow(0 0 10px rgba(0,212,255,.6));
    transition: filter .3s ease;
  }
  .nav-logo:hover .nav-logo-img {
    filter: brightness(0) invert(1) drop-shadow(0 0 18px rgba(0,212,255,.9));
  }
  .nav-logo-text {
    display: flex; flex-direction: column; gap: .05rem;
    font-family: var(--ff-display); font-size: 1.4rem; letter-spacing: .12em; line-height: 1;
  }
  .nav-logo-text b { color: var(--blue); }
  .nav-logo-sub {
    font-family: var(--ff-mono); font-size: .46rem;
    letter-spacing: .3em; text-transform: uppercase;
    color: var(--blue); opacity: .75;
  }
  .nav-links {
    list-style: none; display: flex; gap: 2.5rem; position: relative; z-index: 1;
  }
  .nav-links a {
    font-family: var(--ff-mono); font-size: .65rem;
    letter-spacing: .18em; text-transform: uppercase; color: var(--muted);
    transition: color .3s;
  }
  .nav-links a:hover { color: var(--blue); }
  .nav-btn {
    font-family: var(--ff-mono);
    font-size: clamp(.58rem, 1.2vw, .75rem);
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--white); background: transparent;
    display: inline-flex; align-items: center; gap: .6rem; white-space: nowrap;
    padding: clamp(.5rem, 1.2vw, .85rem) clamp(.9rem, 2.5vw, 1.6rem);
    border: 1px solid rgba(255,255,255,.7);
    cursor: pointer;
    border-radius: 6px;
    position: relative; z-index: 1;
    overflow: hidden;
    transition: color .35s ease, border-color .35s ease;
  }
  .nav-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--blue);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform .35s ease;
    z-index: -1;
  }
  .nav-btn:hover::before { transform: scaleY(1); }
  .nav-btn:hover { color: var(--bg); border-color: var(--blue); }

  /* ─── HERO ─── */
  .hero {
    height: 100svh; min-height: 680px; position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none; z-index: 2;
    background: radial-gradient(ellipse 54% 64% at 50% 49%, rgba(7,9,30,.72) 0%, rgba(7,9,30,.38) 44%, transparent 72%);
  }
  .hero-glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 55% 65% at 15% 55%, rgba(168,85,247,.28) 0%, transparent 70%),
      radial-gradient(ellipse 60% 70% at 80% 50%, rgba(0,212,255,.20) 0%, transparent 70%),
      radial-gradient(ellipse 45% 45% at 50% 100%, rgba(255,45,120,.22) 0%, transparent 60%),
      radial-gradient(ellipse 80% 50% at 50% 0%,   rgba(100,80,200,.12)  0%, transparent 70%);
  }
  .hero-spotlight {
    position: absolute;
    right: 0; top: 0; bottom: 0; width: 62%;
    pointer-events: none; z-index: 0;
    background:
      radial-gradient(ellipse 75% 80% at 65% 48%,
        rgba(0,212,255,.13)   0%,
        rgba(168,85,247,.10)  35%,
        transparent           70%);
  }
  .hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, black, transparent);
  }
  /* Canvas de partículas */
  .particle-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none; z-index: 1;
    display: block;
  }
  .hero-dj-wrap {
    --dj-x: 10%;
    --dj-y: -42%;
    --dj-y-float: -44%;
    --dj-scroll-y: 0px;
    --dj-cursor-x: 0px;
    --dj-cursor-y: 0px;
    --dj-rotate: -1deg;
    position: absolute;
    right: 0; top: 50%;
    width: clamp(360px, 31vw, 560px);
    height: min(91vh, 790px);
    pointer-events: auto; z-index: 1;
    transform: translate(
      calc(var(--dj-x) + var(--dj-cursor-x)),
      calc(var(--dj-y) + var(--dj-scroll-y) + var(--dj-cursor-y))
    ) rotate(var(--dj-rotate));
    opacity: .94;
    transform-origin: 65% 50%;
    filter: drop-shadow(0 0 32px rgba(0,212,255,.14)) drop-shadow(0 0 70px rgba(168,85,247,.12));
    animation: djFloat 6s ease-in-out infinite;
    will-change: transform, opacity;
    mask-image: none;
    -webkit-mask-image: none;
  }
  .hero-dj-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center right;
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: 54% 46%;
    transition: transform .42s cubic-bezier(.22,1,.36,1), filter .42s cubic-bezier(.22,1,.36,1);
    filter: saturate(1.04) contrast(1.03);
  }
  .hero-dj-wrap:hover .hero-dj-img {
    transform: scale(1.035) translateY(-8px);
    filter: saturate(1.14) contrast(1.06) brightness(1.04);
  }
  @keyframes djFloat {
    0%, 100% {
      transform: translate(
        calc(var(--dj-x) + var(--dj-cursor-x)),
        calc(var(--dj-y) + var(--dj-scroll-y) + var(--dj-cursor-y))
      ) rotate(var(--dj-rotate));
    }
    50% {
      transform: translate(
        calc(var(--dj-x) + var(--dj-cursor-x)),
        calc(var(--dj-y-float) + var(--dj-scroll-y) + var(--dj-cursor-y))
      ) rotate(calc(var(--dj-rotate) + 1.2deg));
    }
  }

  .hero-shapes { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    perspective: 900px;
    overflow: hidden;
  }
  .hero-particle {
    position: absolute;
    width: var(--particle-size, 10px);
    height: var(--particle-size, 10px);
    border-radius: 50%;
    background: rgba(0,212,255,.78);
    box-shadow: 0 0 18px rgba(0,212,255,.45);
    opacity: var(--particle-opacity, .85);
    transform: translate3d(-50%, -50%, 0) scale(var(--particle-scale, 1));
    will-change: transform, opacity;
    animation: particleFloat var(--particle-speed, 9s) ease-in-out infinite alternate;
    mix-blend-mode: screen;
  }
  @keyframes particleFloat {
    from { transform: translate3d(-50%, -50%, 0) scale(var(--particle-scale, 1)); }
    to   { transform: translate3d(-50%, -50%, 0) translateY(-12px) scale(var(--particle-scale, 1)); }
  }
  .h-shape {
    position: absolute; border: 1px solid;
    transform-style: preserve-3d;
    animation: floatShape linear infinite;
  }
  .h-shape--1 { width:70px;height:70px;top:22%;left:7%;border-color:rgba(0,212,255,.12);animation-duration:14s;animation-delay:-4s; }
  .h-shape--2 { width:44px;height:44px;top:68%;right:8%;border-color:rgba(168,85,247,.14);animation-duration:11s;animation-delay:-7s;border-radius:6px; }
  .h-shape--3 { width:100px;height:100px;top:38%;right:3%;border-color:rgba(255,45,120,.08);animation-duration:18s; }
  .h-shape--4 { width:32px;height:32px;bottom:20%;left:12%;border-color:rgba(0,212,255,.1);animation-duration:9s;animation-delay:-3s; }
  @keyframes floatShape {
    0%   { transform: translateY(0px) rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
    25%  { transform: translateY(-22px) rotateX(45deg) rotateY(90deg) rotateZ(18deg); }
    50%  { transform: translateY(-12px) rotateX(90deg) rotateY(45deg) rotateZ(-32deg); }
    75%  { transform: translateY(-28px) rotateX(45deg) rotateY(135deg) rotateZ(48deg); }
    100% { transform: translateY(0px) rotateX(0deg) rotateY(180deg) rotateZ(0deg); }
  }

  .hero-content {
    position: relative; z-index: 3; text-align: center; padding: 0 2rem;
    display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem;
    padding-bottom: 5.5rem; /* leave space for scroll indicator */
    max-width: 720px; margin: 0 auto;
  }
  .hero-eyebrow {
    font-family: var(--ff-mono); font-size: .6rem;
    letter-spacing: .45em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 1.75rem;
  }
  .hero-title { font-family: var(--ff-display); font-size: clamp(3.8rem, 8.5vw, 8.5rem); line-height: 1; letter-spacing: -.01em; }
  .hero-title-wrap { overflow: visible; display: block; margin-bottom: .1em; }
  .hero-title-wrap:last-child { margin-bottom: 0; }
  .hero-title-line { display: block; line-height: 1; }
  .hero-title-line.outline { color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,.48); }
  .hero-sub {
    margin: 2.5rem auto 0;
    max-width: 500px;
    display: flex; flex-direction: column; align-items: center; gap: .55rem;
    text-align: center;
  }
  .hero-sub-top, .hero-sub-bottom {
    font-family: var(--ff-mono);
    font-size: clamp(.48rem, 1.1vw, .58rem);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(238,238,245,.62);
    font-weight: 400;
  }
  .hero-sub-glow {
    font-family: var(--ff-display);
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1;
    letter-spacing: .05em;
    display: flex; flex-direction: column; align-items: center;
    background: linear-gradient(100deg, #00d4ff 0%, #a855f7 55%, #00d4ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 18px rgba(0,212,255,.65)) drop-shadow(0 0 40px rgba(168,85,247,.35));
  }
  .hero-scroll {
    position: absolute; bottom: 3.5rem; left: 50%;
    transform: translateX(-50%); z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: .75rem;
  }
  .hero-scroll span { font-family: var(--ff-mono); font-size: .55rem; letter-spacing: .35em; text-transform: uppercase; color: var(--muted); }
  .hero-scroll-line { width: 1px; height: 56px; background: linear-gradient(to bottom, var(--blue), transparent); animation: pulse-line 2.2s ease-in-out infinite; }
  @media (max-width: 1420px) {
    .hero-dj-wrap {
      --dj-x: 26%;
      --dj-y: -42%;
      --dj-y-float: -44%;
      width: clamp(300px, 25vw, 420px);
      opacity: .82;
    }
  }
  @media (max-width: 1180px) {
    .hero-dj-wrap { display: none; }
    .hero::after {
      background: radial-gradient(ellipse 62% 66% at 50% 49%, rgba(7,9,30,.56) 0%, rgba(7,9,30,.24) 48%, transparent 76%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-dj-wrap {
      animation: none;
      transform: translate(var(--dj-x), var(--dj-y)) rotate(-1deg);
    }
    .hero-dj-img { transition: none; }
    .hero-dj-wrap:hover .hero-dj-img { transform: none; }
  }
  @keyframes pulse-line {
    0%,100% { opacity: .3; transform: scaleY(1) translateY(0); }
    50%      { opacity: 1;  transform: scaleY(.65) translateY(-8px); }
  }

  /* ─── TICKER ─── */
  .ticker { padding: 1.25rem 0; overflow: hidden; background: var(--bg2); border-top: 1px solid rgba(255,255,255,.04); border-bottom: 1px solid rgba(255,255,255,.04); }
  .ticker-track { display: flex; gap: 3.5rem; width: max-content; animation: ticker-move 24s linear infinite; }
  .ticker-item { display: flex; align-items: center; gap: 1.25rem; flex-shrink: 0; font-family: var(--ff-display); font-size: .85rem; letter-spacing: .25em; color: var(--muted); white-space: nowrap; }
  .ticker-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); flex-shrink: 0; }
  @keyframes ticker-move { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ─── LAYOUT ─── */
  .container { max-width: 1380px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 3rem); }
  .label { font-family: var(--ff-mono); font-size: clamp(.5rem, 1.5vw, .6rem); letter-spacing: .35em; text-transform: uppercase; color: var(--blue); display: flex; align-items: center; gap: .9rem; }
  .label::before { content: ''; width: 28px; height: 1px; background: var(--blue); }
  .section-title { font-family: var(--ff-display); font-size: clamp(1.8rem, 5.5vw, 5rem); line-height: .95; letter-spacing: .02em; }
  .section-title i { font-style: normal; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.25); }

  /* ─── ABOUT ─── */
  .about { padding: clamp(6rem, 10vw, 11rem) 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7rem; align-items: center; }
  .about-label { margin-bottom: 1.5rem; }
  .about-text { text-align: left; }
  .about-title { margin-bottom: 2rem; }
  .about-body { font-size: clamp(.8rem, 1.8vw, .9rem); font-weight: 300; color: var(--subtle); line-height: 1.85; max-width: 440px; }
  .about-body + .about-body { margin-top: 1.2rem; }
  .img-frame { position: relative; overflow: hidden; height: 560px; }
  .img-frame::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(135deg, rgba(168,85,247,.18) 0%, transparent 55%); }
  .img-frame img { height: 140%; transform-origin: center top; will-change: transform; }

  /* ─── VINYL SECTION ─── */
  .vinyl-section { padding: clamp(6rem, 10vw, 11rem) 0; background: var(--bg2); overflow: hidden; position: relative; }
  .vinyl-section::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 50% 60% at 70% 50%, rgba(168,85,247,.08) 0%, transparent 100%), radial-gradient(ellipse 40% 50% at 30% 50%, rgba(0,212,255,.05) 0%, transparent 100%); }
  .vinyl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 6rem); align-items: center; }
  .vinyl-text { text-align: left; }
  .vinyl-text > * + * { margin-top: 1.5rem; }
  .vinyl-body { font-size: clamp(.8rem, 1.8vw, .9rem); font-weight: 300; color: var(--subtle); line-height: 1.85; max-width: 420px; }
  .vinyl-facts { display: flex; flex-direction: column; gap: .75rem; margin-top: 2.5rem; }
  .vinyl-fact { display: flex; align-items: center; gap: 1rem; font-family: var(--ff-mono); font-size: clamp(.55rem, 1.3vw, .62rem); letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
  .vinyl-fact::before { content: ''; width: 16px; height: 1px; background: var(--blue); flex-shrink: 0; }
  .vinyl-stage { display: flex; justify-content: center; align-items: center; perspective: 1400px; }
  .vinyl-tilt { transform-style: preserve-3d; will-change: transform; }
  .vinyl-spin { transform-style: preserve-3d; animation: vinylSpin 12s linear infinite; }
  @keyframes vinylSpin { to { transform: rotateZ(360deg); } }
  .vinyl-disc { width: clamp(320px, 42vw, 500px); height: clamp(320px, 42vw, 500px); border-radius: 50%; position: relative; background: repeating-radial-gradient(circle at 50% 50%, transparent 0px, transparent 5px, rgba(255,255,255,.018) 5px, rgba(255,255,255,.018) 6px), radial-gradient(circle at 50% 50%, #1c1c35 0%, #08081a 70%, #04040f 100%); box-shadow: 0 0 0 1.5px rgba(0,212,255,.14), 0 0 80px rgba(168,85,247,.15), 0 0 160px rgba(168,85,247,.06), inset 0 0 60px rgba(0,0,0,.6); }
  .v-holo { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; background: conic-gradient(from 0deg, transparent 0deg, rgba(0,212,255,.07) 60deg, rgba(168,85,247,.09) 120deg, rgba(255,45,120,.06) 180deg, transparent 240deg, rgba(0,212,255,.05) 300deg, transparent 360deg); animation: holoShift 9s linear infinite; }
  @keyframes holoShift { to { transform: rotate(360deg); } }
  .v-spec { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; background: linear-gradient(135deg, rgba(255,255,255,.07) 0%, transparent 45%); }
  .v-ring { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); border-radius: 50%; border: 1px solid; pointer-events: none; }
  .v-ring--a { width: 90%; height: 90%; border-color: rgba(0,212,255,.2); }
  .v-ring--b { width: 72%; height: 72%; border-color: rgba(168,85,247,.18); }
  .v-ring--c { width: 52%; height: 52%; border-color: rgba(255,45,120,.14); }
  .v-ring--d { width: 33%; height: 33%; border-color: rgba(0,212,255,.18); }
  .v-label { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 110px; height: 110px; border-radius: 50%; background: radial-gradient(circle at 38% 38%, #2e1e52, #0d0a1e 80%); box-shadow: 0 0 28px rgba(168,85,247,.45), inset 0 0 18px rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; }
  .v-logo { width: 48px; height: 48px; object-fit: contain; filter: brightness(0) invert(1); }
  .v-hole { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 18px; height: 18px; border-radius: 50%; background: var(--bg2); border: 1px solid rgba(255,255,255,.08); }

  /* ─── SERVICES ─── */
  .services { padding: clamp(5rem, 9vw, 9rem) 0; background: var(--bg); }
  .services-head { text-align: center; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .services-head .label { justify-content: center; margin-bottom: 1rem; }
  .services-grid { display: grid; grid-template-columns: repeat(3,1fr); border: 1px solid rgba(255,255,255,.05); }
  .s-card { padding: clamp(1.8rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem); position: relative; overflow: hidden; border-right: 1px solid rgba(255,255,255,.05); transition: background .4s; transform-style: preserve-3d; will-change: transform; }
  .s-card:last-child { border-right: none; }
  .s-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--blue), transparent); transform: scaleX(0); transform-origin: left; transition: transform .5s ease; }
  .s-card:hover::before { transform: scaleX(1); }
  .s-card:hover { background: var(--bg3); }
  .s-gloss { position: absolute; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, rgba(0,212,255,.35) 0%, transparent 65%); top: 50%; left: 50%; transform: translate(-50%,-50%); opacity: 0; pointer-events: none; z-index: 0; mix-blend-mode: screen; }
  .s-num { font-family: var(--ff-mono); font-size: clamp(.5rem, 1.3vw, .58rem); letter-spacing: .25em; color: var(--muted); margin-bottom: 1.75rem; position: relative; z-index: 1; }
  .s-icon { width: 44px; height: 44px; margin-bottom: 1.75rem; position: relative; z-index: 1; }
  .s-name { font-family: var(--ff-display); font-size: clamp(1.3rem, 2.8vw, 2.2rem); letter-spacing: .04em; margin-bottom: 1rem; position: relative; z-index: 1; }
  .s-desc { font-size: clamp(.7rem, 1.6vw, .85rem); font-weight: 300; color: var(--subtle); line-height: 1.8; position: relative; z-index: 1; }

  /* ─── GALLERY ─── */
  .gallery { padding: clamp(5rem, 9vw, 9rem) 0; }
  .gallery-head { display: flex; justify-content: center; align-items: center; flex-direction: column; gap: 1rem; margin-bottom: 3.5rem; text-align: center; }
  .gallery-head-right { font-size: clamp(.7rem, 1.6vw, .95rem); font-weight: 300; color: var(--subtle); line-height: 1.7; max-width: 720px; text-align: center; }
  .gallery-stack {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(.6rem, 1.5vw, 1rem);
    align-items: start;
  }
  .g-row {
    display: contents;
  }
  .g-item {
    position: relative;
    overflow: hidden;
    background: var(--bg3);
    aspect-ratio: 4/3;
  }
  .g-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform-origin: center;
  }
  /* ensure images are centered inside their containers */
  .g-item img, .eq-img img { display: block; margin: 0 auto; }
  /* center content for main sections */
  .gallery, .about, .services, .equipment, .vinyl-section, .cta-section, .stats { text-align: center; }
  /* Ensure gallery and stats render above pinned equipment when GSAP pinning occurs */
  .gallery, .stats { position: relative; z-index: 2; }
  .equipment { position: relative; z-index: 1; }
  /* Reduce potential overlap caused by GSAP pin wrapper */
  .gsap-pin-spacer { z-index: 0 !important; }
  .gsap-pin-spacer > .equipment { z-index: 0 !important; }
  .g-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(7,9,30,.75) 0%, transparent 55%); opacity: 0; transition: opacity .45s; }
  .g-item:hover .g-overlay { opacity: 1; }
  .g-tag { position: absolute; bottom: 1.25rem; left: 1.25rem; z-index: 2; font-family: var(--ff-mono); font-size: .58rem; letter-spacing: .2em; text-transform: uppercase; color: var(--white); opacity: 0; transform: translateY(8px); transition: all .4s ease; }
  .g-item:hover .g-tag { opacity: 1; transform: translateY(0); }

  /* ─── STATS ─── */
  .stats { padding: clamp(4rem, 8vw, 6.5rem) 0; background: var(--bg2); border-top: 1px solid rgba(255,255,255,.04); border-bottom: 1px solid rgba(255,255,255,.04); }
  .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(1rem, 2vw, 2rem); }
  .stat { text-align: center; position: relative; }
  .stat + .stat::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); height: 55%; width: 1px; background: rgba(255,255,255,.06); }
  .stat-num { font-family: var(--ff-display); font-size: clamp(2rem, 5vw, 5.5rem); line-height: 1; color: var(--blue); margin-bottom: .4rem; }
  .stat-lbl { font-family: var(--ff-mono); font-size: clamp(.5rem, 1.3vw, .58rem); letter-spacing: .22em; text-transform: uppercase; color: var(--subtle); }

  /* ─── EQUIPMENT ─── */
  .equipment { padding: clamp(5rem, 9vw, 9rem) 0 0; }
  .equip-head { margin-bottom: clamp(2rem, 4vw, 3.5rem); text-align: center; }
  .equip-head .label { margin-bottom: 1rem; justify-content: center; }
  .h-outer { overflow: hidden; display: flex; justify-content: center; padding: 0 0 4rem; }
  .h-track { position: relative; width: 480px; height: 520px; }
  .eq-card { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg3); overflow: hidden; will-change: transform; border-radius: 10px; }
  .eq-img { height: 340px; overflow: hidden; position: relative; background: rgba(7,9,30,.12); }
  .eq-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.28);
    pointer-events: none;
    transition: background .28s ease;
    border-radius: 0;
  }
  .eq-card:hover .eq-img::after { background: rgba(0,0,0,.08); }
  .eq-img img {
    filter: grayscale(1);
    transition: filter .6s ease, transform .6s ease;
    will-change: transform, filter;
    transform: translateZ(0);
    display: block; width: 100%; height: 100%; object-fit: cover;
  }
  .eq-card:hover .eq-img img { transform: scale(1.06); filter: grayscale(0); }
  .eq-info { padding: 1.75rem; }
  .eq-name { font-family: var(--ff-display); font-size: clamp(1.2rem, 2.3vw, 1.6rem); letter-spacing: .04em; margin-bottom: .5rem; }
  .eq-desc { font-size: clamp(.7rem, 1.4vw, .8rem); color: var(--subtle); line-height: 1.65; }

  /* ─── CTA ─── */
  .cta-section { padding: clamp(6rem, 10vw, 12rem) clamp(1rem, 5vw, 3rem); text-align: center; position: relative; overflow: hidden; }
  .cta-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 65% 65% at 50% 50%, rgba(168,85,247,.10) 0%, transparent 100%); }
  .cta-orb { position: absolute; top: 50%; left: 50%; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, rgba(168,85,247,.2), rgba(0,212,255,.07) 50%, transparent 70%); filter: blur(50px); transform: translate(-50%,-50%); animation: orbPulse 5s ease-in-out infinite; pointer-events: none; }
  @keyframes orbPulse { 0%,100% { transform: translate(-50%,-50%) scale(1); opacity: .7; } 50% { transform: translate(-50%,-50%) scale(1.18); opacity: 1; } }
  .cta-content { position: relative; z-index: 1; max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .cta-title { font-family: var(--ff-display); font-size: clamp(2.5rem, 8vw, 8rem); line-height: .92; margin-bottom: clamp(1rem, 3vw, 2rem); }
  .cta-title em { font-style: normal; color: var(--blue); }
  .cta-text { font-family: var(--ff-mono); font-size: clamp(.5rem, 1.2vw, .62rem); font-weight: 400; letter-spacing: .2em; text-transform: uppercase; color: rgba(238,238,245,.62); line-height: 2.2; margin-bottom: clamp(1.5rem, 3vw, 3rem); }
  .cta-btn {
    display: inline-flex; align-items: center; gap: .85rem;
    font-family: var(--ff-mono); font-size: clamp(.55rem, 1.3vw, .7rem); letter-spacing: .14em; text-transform: uppercase;
    color: var(--white); background: transparent;
    padding: clamp(.7rem, 1.8vw, 1.1rem) clamp(1.2rem, 3.5vw, 2.6rem); border: 1px solid rgba(255,255,255,.7);
    cursor: pointer; border-radius: 8px;
    position: relative; overflow: hidden;
    transition: color .35s ease, border-color .35s ease;
  }
  .cta-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--blue);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform .35s ease;
    z-index: -1;
  }
  .cta-btn:hover::before { transform: scaleY(1); }
  .cta-btn:hover { color: var(--bg); border-color: var(--blue); }
  .cta-mail { display: block; margin-top: 2rem; font-family: var(--ff-mono); font-size: clamp(.55rem, 1.3vw, .65rem); letter-spacing: .15em; color: var(--muted); transition: color .3s; }
  .cta-mail:hover { color: var(--blue); }

  footer {
    position: relative;
    overflow: hidden;
    background: rgba(7, 9, 30, 0.92);
    border-top: 1px solid rgba(255,255,255,.06);
  }

  footer::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: none;
  }

  .foot-top {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 1.8fr) repeat(3, minmax(150px, .7fr));
    gap: clamp(2.5rem, 5vw, 5.75rem);
    width: 100%;
    padding: clamp(4rem, 7vw, 6.5rem) 0 3.75rem;
    align-items: start;
    justify-items: start;
    text-align: left;
  }

  .foot-brand {
    display: flex;
    flex-direction: column;
    gap: 1.55rem;
    max-width: 360px;
  }

  .foot-col {
    display: flex;
    flex-direction: column;
    gap: .72rem;
    min-width: 0;
    align-items: center;
  }

  .foot-logo {
    display: flex;
    align-items: center;
    gap: .8rem;
    font-family: var(--ff-display);
    font-size: 1.4rem;
    letter-spacing: .12em;
    line-height: 1;
  }

  .foot-logo-img {
    width: 52px; height: 52px;
    object-fit: contain; flex-shrink: 0;
    filter: brightness(0) invert(1) drop-shadow(0 0 10px rgba(0,212,255,.55));
  }

  .foot-logo-text { display: flex; flex-direction: column; gap: .05rem; }
  .foot-logo-name { display: block; }
  .foot-logo-text b { color: var(--blue); }

  .foot-logo-sub {
    font-family: var(--ff-mono);
    font-size: .46rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--blue);
    opacity: .75;
  }

  .foot-tagline {
    font-size: .86rem;
    font-weight: 300;
    color: var(--subtle);
    line-height: 1.8;
    text-wrap: pretty;
  }

  .foot-social { display: flex; gap: .75rem; flex-wrap: wrap; }

  .foot-social a {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.015);
    color: var(--muted);
    border-radius: 8px;
    transition: border-color .3s, color .3s, background .3s, transform .25s ease;
  }

  .foot-social a:hover {
    border-color: var(--blue);
    color: var(--blue);
    background: rgba(0,212,255,.06);
    transform: translateY(-2px);
  }

  .foot-social a:focus-visible,
  .foot-col a:focus-visible,
  .foot-legal a:focus-visible {
    outline: 2px solid rgba(0,212,255,.75);
    outline-offset: 4px;
  }

  .foot-col-title {
    font-family: var(--ff-mono);
    font-size: .58rem;
    letter-spacing: .28em;
    margin-right: -.28em;
    text-transform: uppercase;
    color: rgba(238,238,245,.78);
    margin-bottom: .55rem;
  }

  .foot-col a {
    font-size: .82rem;
    font-weight: 300;
    color: var(--muted);
    transition: color .25s, transform .25s ease;
    line-height: 1.45;
  }

  .foot-col a:hover {
    color: var(--blue);
    transform: translateX(4px);
  }

  .foot-col address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: .68rem;
    font-size: .82rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.55;
  }

  .foot-col address a { color: var(--muted); transition: color .25s, transform .25s ease; }
  .foot-col address a:hover { color: var(--blue); }
  .foot-col address span { color: var(--muted); }

  .foot-divider {
    position: relative;
    z-index: 1;
    height: 1px;
    margin: 0;
    background: rgba(255,255,255,.06);
  }

  .foot-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.45rem 0 1.65rem;
    gap: 1rem;
  }

  .foot-copy {
    font-family: var(--ff-mono);
    font-size: .55rem;
    letter-spacing: .12em;
    color: var(--muted);
  }

  .foot-legal { display: flex; align-items: center; gap: 2rem; }

  .foot-legal a {
    font-family: var(--ff-mono);
    font-size: .55rem;
    letter-spacing: .12em;
    color: var(--muted);
    transition: color .25s;
    white-space: nowrap;
  }

  .foot-legal a:hover { color: var(--blue); }

  /* Responsive Breakpoints */
  
  /* Tablet Large: 1100px and below */
  @media (max-width: 1100px) {
    .vinyl-grid { grid-template-columns: 1fr; }
    .vinyl-text { text-align: center; justify-self: center; }
    .vinyl-text .label { justify-content: center; }
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .foot-top {
      grid-template-columns: minmax(200px, 1fr) repeat(2, minmax(120px, 1fr));
      gap: clamp(1.5rem, 3vw, 2rem);
    }
  }

  /* Tablet: 900px and below */
  @media (max-width: 900px) {
    .hero { min-height: 70vh; }
    .hero-scroll { bottom: 2rem; }
    .gallery-grid { grid-template-columns: 1fr; }
    .services-grid { grid-template-columns: 1fr; border: none; }
    .s-card { border: 1px solid rgba(255,255,255,.05); margin-bottom: 1rem; border-right: none; }
    .s-card:last-child { border-bottom: 1px solid rgba(255,255,255,.05); }
    .vinyl-grid { gap: clamp(2rem, 4vw, 3rem); }
    .stats { padding: clamp(3rem, 7vw, 6.5rem) 0; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: clamp(1.5rem, 2vw, 2rem); }
    .stat + .stat::before { display: none; }
    .about-grid { grid-template-columns: 1fr; gap: clamp(2rem, 4vw, 4rem); }
    .about-text { text-align: center; }
    .about-label { justify-content: center; }
    .img-frame { height: clamp(300px, 60vw, 400px); }
    .foot-top {
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
    }
    .foot-brand { grid-column: 1 / -1; }
    .foot-divider { margin: 0; }
    .foot-bottom { flex-direction: column; align-items: center; padding: clamp(.75rem, 2vw, 1.25rem) 0; gap: .75rem; }
    .foot-legal { flex-wrap: wrap; gap: 1rem; }
  }

  /* Mobile: 768px and below */
  @media (max-width: 768px) {
    .gallery-stack { grid-template-columns: 1fr; }
    .hero { min-height: 60vh; padding-top: clamp(5rem, 12vw, 7rem); }
    /* increase hero title on smaller screens for better visibility */
    .hero-title { font-size: clamp(3.2rem, 9vw, 4.8rem); }
    .hero-title-wrap { margin-bottom: clamp(.15em, 0.3vw, .25em); }
    .hero-sub { font-size: clamp(.75rem, 1.8vw, .9rem); max-width: 95%; }
    .gallery-grid { grid-template-columns: 1fr; gap: clamp(1rem, 2vw, 1.5rem); }
    .gallery-head { flex-direction: column; gap: 1.5rem; }
    .gallery-head-right { text-align: left; max-width: none; }
    .equipment { padding: clamp(4rem, 7vw, 9rem) 0 0; }
    .h-track { width: clamp(340px, 80vw, 480px); height: clamp(440px, 65vw, 520px); }
  }

  /* Mobile: 640px and below */
  @media (max-width: 640px) {
    #mainNav { padding: clamp(.75rem, 2vw, 1rem) 0; }
    .nav-inner { gap: clamp(.5rem, 2vw, 1rem); }
    .nav-logo { font-size: clamp(.95rem, 3vw, 1.4rem); }
    .nav-logo-img { width: clamp(36px, 8vw, 48px); height: clamp(36px, 8vw, 48px); }
    .nav-links { display: none; }
    .nav-btn { 
      font-size: clamp(.5rem, 1vw, .65rem);
      padding: clamp(.5rem, 1.2vw, .65rem) clamp(.8rem, 2vw, 1.2rem);
    }
    .hero { min-height: auto; padding-top: clamp(1rem, 3vw, 2rem); padding-bottom: clamp(2rem, 5vw, 3rem); }
    .hero-content { padding: clamp(1rem, 3vw, 1.5rem); gap: 0.8rem; }
    .hero-eyebrow { font-size: clamp(.4rem, 1vw, .55rem); margin-bottom: clamp(.75rem, 2vw, 1.5rem); }
    .hero-title { font-size: clamp(4rem, 11vw, 5.5rem); }
    .hero-logo { width: clamp(190px, 50vw, 240px); height: clamp(190px, 50vw, 240px); margin-bottom: 0; }
    .hero-title-wrap { margin-bottom: clamp(.1em, 0.3vw, .2em); }
    .hero-sub { margin-top: 2.5rem; }
    .hero-sub-glow { font-size: clamp(1.8rem, 9vw, 2.6rem); }
    .hero-scroll { display: none; }
    .container { padding: 0 clamp(.8rem, 4vw, 1.2rem); }
    .label { font-size: clamp(.52rem, 1.3vw, .62rem); }
    .section-title { font-size: clamp(2.2rem, 7vw, 3rem); }
    .about { padding: clamp(3rem, 6vw, 6rem) 0; }
    .about-grid { gap: clamp(1.5rem, 3vw, 2.5rem); }
    .about-body { font-size: clamp(.7rem, 1.6vw, .8rem); }
    .about-body + .about-body { margin-top: 1rem; }
    .vinyl-section { padding: clamp(3rem, 6vw, 6rem) 0; }
    .vinyl-text > * + * { margin-top: 1rem; }
    .vinyl-body { font-size: clamp(.7rem, 1.6vw, .8rem); }
    .vinyl-fact { font-size: clamp(.48rem, 1.2vw, .55rem); }
    .vinyl-disc { width: clamp(220px, 65vw, 300px); height: clamp(220px, 65vw, 300px); }
    .v-logo { width: clamp(36px, 7vw, 44px); height: clamp(36px, 7vw, 44px); }
    .services { padding: clamp(3rem, 6vw, 5rem) 0; }
    .services-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
    .services-grid { grid-template-columns: 1fr; }
    .s-card { padding: clamp(1.2rem, 3vw, 1.8rem) clamp(1rem, 2vw, 1.5rem); margin-bottom: clamp(.75rem, 1.5vw, 1rem); border: 1px solid rgba(255,255,255,.05); }
    .s-num { font-size: clamp(.45rem, 1vw, .5rem); }
    .s-name { font-size: clamp(1.1rem, 2.5vw, 1.6rem); }
    .s-desc { font-size: clamp(.65rem, 1.4vw, .7rem); }
    .stats { padding: clamp(2.5rem, 5vw, 4rem) 0; }
    .stats-grid { grid-template-columns: 1fr; gap: clamp(1rem, 2vw, 1.5rem); }
    .stat-num { font-size: clamp(1.5rem, 4vw, 2.5rem); }
    .stat-lbl { font-size: clamp(.45rem, 1vw, .5rem); }
    .equipment { padding: clamp(3rem, 6vw, 5rem) 0 0; }
    .equip-head { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
    .h-track { width: min(88vw, 420px); height: clamp(380px, 95vw, 470px); }
    .eq-img { height: clamp(240px, 58vw, 320px); }
    .eq-info { padding: clamp(1rem, 2vw, 1.5rem); }
    .eq-name { font-size: clamp(1rem, 2vw, 1.3rem); }
    .eq-desc { font-size: clamp(.65rem, 1.4vw, .7rem); }
    .cta-section { padding: clamp(4rem, 8vw, 6rem) clamp(.75rem, 3vw, 2rem); }
    .cta-orb { width: 300px; height: 300px; }
    .cta-title { font-size: clamp(3.4rem, 11vw, 5rem); margin-bottom: clamp(1.2rem, 3vw, 2rem); line-height: .95; }
    .cta-text { font-size: clamp(.68rem, 1.8vw, .82rem); margin-bottom: clamp(1.8rem, 4vw, 2.5rem); }
    .cta-btn {
      font-size: clamp(.58rem, 1.4vw, .7rem);
      padding: clamp(.75rem, 2vw, 1rem) clamp(1.8rem, 5vw, 2.5rem);
    }
    .cta-mail { font-size: clamp(.58rem, 1.3vw, .68rem); margin-top: 2rem; }
    footer { padding: clamp(2rem, 4vw, 3rem) 0 clamp(1.5rem, 3vw, 2rem); }
    .foot-top {
      grid-template-columns: 1fr;
      gap: clamp(1.2rem, 2.5vw, 2rem);
      padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    }
    .foot-top { justify-items: center; text-align: center; }
    .foot-brand { max-width: none; margin-bottom: 1rem; align-items: center; text-align: center; }
    .foot-logo { font-size: clamp(.85rem, 2.5vw, 1rem); margin-bottom: clamp(.5rem, 1vw, .75rem); }
    .foot-col { margin-bottom: clamp(1rem, 2vw, 1.5rem); }
    .foot-col:last-child { margin-bottom: 0; }
    .foot-col-title { font-size: clamp(.42rem, 1vw, .48rem); }
    .foot-col a, .foot-col address { font-size: clamp(.65rem, 1.4vw, .75rem); line-height: 1.6; }
    .foot-social { gap: clamp(.5rem, 1vw, .75rem); }
    .foot-social a { width: clamp(30px, 7vw, 36px); height: clamp(30px, 7vw, 36px); font-size: clamp(.7rem, 1.5vw, .85rem); }
    .foot-divider { display: none; }
    .foot-bottom { padding: clamp(.75rem, 1.5vw, 1rem) 0 0; gap: clamp(.5rem, 1vw, .75rem); border-top: 1px solid rgba(255,255,255,.05); }
    .foot-copy { font-size: clamp(.42rem, 1vw, .48rem); }
    .foot-legal { gap: clamp(.5rem, 1vw, .75rem); }
    .foot-legal a { font-size: clamp(.42rem, 1vw, .48rem); }
