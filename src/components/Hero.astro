---
---
<section class="hero" id="inicio">
  <div class="hero-glow"      aria-hidden="true"></div>
  <div class="hero-spotlight" aria-hidden="true"></div>
  <div class="hero-grid"      aria-hidden="true"></div>

  <div class="hero-content">

    <!-- Columna izquierda: texto + cards -->
    <div class="hero-left">
      <h1 class="hero-title" aria-label="BIOSFERA Producción">
        <span class="hero-title-wrap"><span class="hero-title-line" id="ht1">BIOSFERA</span></span>
        <span class="hero-title-wrap"><span class="hero-title-line outline" id="ht2">PRODUCCIÓN</span></span>
      </h1>

      <div class="hero-sub" id="h-sub">
        <span class="hero-sub-top">Transformamos cada evento en una experiencia sensorial.</span>
        <span class="hero-sub-glow">Luz, sonido y emoción</span>
        <span class="hero-sub-bottom">al servicio de tu momento.</span>
      </div>

      <div class="hero-cards">
        <div class="hero-card">
          <span class="hero-card-value">GDL</span>
          <span class="hero-card-label">Guadalajara, Jalisco</span>
        </div>
        <div class="hero-card">
          <span class="hero-card-value">10+</span>
          <span class="hero-card-label">Años de experiencia</span>
        </div>
        <div class="hero-card">
          <span class="hero-card-value">500+</span>
          <span class="hero-card-label">Eventos realizados</span>
        </div>
        <div class="hero-card">
          <span class="hero-card-value">100K</span>
          <span class="hero-card-label">Watts de sonido</span>
        </div>
      </div>
    </div>

    <!-- Columna derecha: logo con órbitas 3D -->
    <div class="hero-right">
      <div class="logo-orbit">
        <div class="logo-orbit-field" aria-hidden="true"></div>
        <div class="logo-orbit-aura" aria-hidden="true"></div>
        <div class="logo-ring logo-ring--equator" aria-hidden="true"><span class="ring-spark"></span></div>
        <div class="logo-ring logo-ring--vertical" aria-hidden="true"><span class="ring-spark"></span></div>
        <div class="logo-ring logo-ring--diagonal-a" aria-hidden="true"><span class="ring-spark"></span></div>
        <div class="logo-ring logo-ring--diagonal-b" aria-hidden="true"><span class="ring-spark"></span></div>
        <div class="logo-core-glow" aria-hidden="true"></div>
        <img src="/logo.png" class="hero-logo" id="h-logo" alt="Biosfera Producción" />
      </div>
    </div>

  </div>

  <div class="hero-scroll" id="h-scroll" aria-hidden="true">
    <div class="hero-scroll-line"></div>
    <span id="scroll-label">Scroll</span>
  </div>
</section>
