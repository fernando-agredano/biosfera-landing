---
import Layout    from '../layouts/Layout.astro';
import Nav       from '../components/Nav.astro';
import Hero      from '../components/Hero.astro';
import Ticker    from '../components/Ticker.astro';
import About     from '../components/About.astro';
import VinylSection from '../components/VinylSection.astro';
import Services  from '../components/Services.astro';
import Gallery   from '../components/Gallery.astro';
import Stats     from '../components/Stats.astro';
import Equipment from '../components/Equipment.astro';
import CTA       from '../components/CTA.astro';
import Footer    from '../components/Footer.astro';

import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import path from 'path';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const mainJs = readFileSync(
  path.join(__dirname, '../../public/scripts/main.js'),
  'utf-8'
);
---

<Layout title="BIOSFERA Producción — Luz & Sonido">
  <Nav />
  <Hero />
  <Ticker />
  <About />
  <VinylSection />
  <Services />
  <Gallery />
  <Stats />
  <Equipment />
  <CTA />
  <Footer />

  <!-- Script inline: Astro no lo procesa con Vite, corre después del DOM -->
  <script is:inline set:html={mainJs}></script>
</Layout>
